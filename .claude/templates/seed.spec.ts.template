import { test, expect } from './fixtures';

// Use a seeded test account from a fixture or env — never a real production credential.
const USER = { email: 'test.user@example.com', password: 'Password123!' };

// .open() lives in the spec, not the fixture, so navigation stays visible here.
test.beforeEach(async ({ loginPage }) => {
  await loginPage.open();
});

test.describe('Login', () => {
  test('logs in with valid credentials @smoke', async ({ loginPage, dashboardPage, page }) => {
    await loginPage.signIn(USER.email, USER.password);

    await expect(page).toHaveURL(/\/dashboard/);
    await expect(dashboardPage.heading).toBeVisible();
  });

  test('rejects an invalid password @regression', async ({ loginPage }) => {
    await loginPage.signIn(USER.email, 'wrong-password');

    // Anchored on the banner's #id, asserted against its (stable) copy.
    await expect(loginPage.error).toHaveText('Your password is invalid!');
  });

  test('logs back out from the dashboard @regression', async ({ loginPage, dashboardPage }) => {
    await test.step('Sign in', async () => {
      await loginPage.signIn(USER.email, USER.password);
      await expect(dashboardPage.logout).toBeVisible();
    });

    await test.step('Sign out', async () => {
      await dashboardPage.signOut();
      await expect(loginPage.submit).toBeVisible();
    });
  });
});
