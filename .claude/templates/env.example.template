# Issue-tracker credentials — OPTIONAL.
#
# Only needed if you wire a tracker MCP so plan-tests can pull tickets by key. Without
# it, paste acceptance criteria into the prompt and everything works the same. Jira is
# shown below; Linear / GitHub Issues / others use their own variables.
#
# Setup:
#   1. cp .env.example .env
#   2. Fill in the values below.
#   3. Uncomment the "jira" block in .mcp.json.
#
# NEVER commit .env.

# Your Atlassian site, no trailing slash.
JIRA_URL=https://your-org.atlassian.net

# The account the API token belongs to.
JIRA_EMAIL=you@example.com

# Create one at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your-atlassian-api-token
